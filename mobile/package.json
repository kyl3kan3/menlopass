{
  "name": "menlopass-mobile",
  "version": "1.0.0",
  "main": "index",
  "dependencies": {
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-file-system": "~57.0.5",
    "expo-observe": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-tracking-transparency": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-appsflyer": "^7.0.2",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-purchases": "^10.6.0",
    "react-native-purchases-ui": "^10.6.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync:web": "npm --prefix .. run build && node scripts/sync-web.cjs",
    "prestart": "npm run sync:web",
