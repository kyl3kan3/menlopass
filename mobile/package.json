  "main": "index",
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.15",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-observe": "~57.0.19",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-symbols": "~57.0.2",
    "expo-tracking-transparency": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-widgets": "~57.0.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-appsflyer": "^7.0.2",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-purchases": "^10.6.0",
    "react-native-purchases-ui": "^10.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync:web": "npm --prefix .. run build && node scripts/sync-web.cjs",
    "prestart": "npm run sync:web",
    "start": "expo start",
    "preandroid": "npm run sync:web",
    "android": "expo start --android",
    "preios": "npm run sync:web",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:contracts": "node --test tests/commerce-tracking.test.cjs modules/menocompass-security/tests/security-contract.test.cjs modules/menocompass-healthkit/tests/healthkit-contract.test.cjs modules/menocompass-shortcuts/tests/app-shortcuts-contract.test.cjs widgets/widgets.test.mjs",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "ota:preview:ios": "npx eas-cli@latest env:exec preview \"node scripts/publish-update.cjs --channel preview --environment preview\"",
    "ota:production:ios": "npx eas-cli@latest env:exec production \"node scripts/publish-update.cjs --channel production --environment production\""
  },
  "private": true
}
