# Public mobile SDK identifiers. Configure the same names in EAS for production builds.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=your_appsflyer_dev_key
EXPO_PUBLIC_META_APP_ID=your_meta_app_id
EXPO_PUBLIC_META_CLIENT_TOKEN=your_meta_client_token

# TikTok App Events SDK. Keep the client credential in an EAS sensitive variable
# so it is absent from Git and build logs. The iOS SDK still embeds it in the app
# binary, so restrict its scope and do not treat it as a server-side secret.
TIKTOK_APP_ID=6798018790
TIKTOK_BUSINESS_APP_ID=7679768878880178197
TIKTOK_APP_SECRET=your_tiktok_app_secret

# RevenueCat uses a public, app-scoped SDK key. Configure it through EAS so each
# build environment remains explicit.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_public_sdk_key

# Sentry crash reporting. The DSN is a public client identifier. Keep the auth
# token with EAS Sensitive visibility; it is used only while uploading native symbols and
# JavaScript source maps. Organization and project are Sentry slugs.
EXPO_PUBLIC_SENTRY_DSN=https://public_key@o0.ingest.sentry.io/project_id
SENTRY_ORG=your_sentry_organization_slug
SENTRY_PROJECT=menocompass
SENTRY_AUTH_TOKEN=your_sentry_source_map_upload_token
