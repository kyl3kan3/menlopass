# Public mobile SDK identifiers. Configure the same names in EAS for production builds.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=your_appsflyer_dev_key
EXPO_PUBLIC_META_APP_ID=your_meta_app_id
EXPO_PUBLIC_META_CLIENT_TOKEN=your_meta_client_token

# TikTok App Events SDK. Keep the secret in an EAS secret environment variable;
# do not rename it with an EXPO_PUBLIC_ prefix or commit a real value here.
TIKTOK_APP_ID=6798018790
TIKTOK_BUSINESS_APP_ID=7679768878880178197
TIKTOK_APP_SECRET=your_tiktok_app_secret

# Existing purchase configuration (the checked-in fallback remains available during migration).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_public_sdk_key
