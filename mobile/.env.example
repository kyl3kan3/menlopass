# Public, app-specific SDK configuration; never put private provider keys here.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=your_peri_appsflyer_dev_key
EXPO_PUBLIC_APPLE_APP_ID=6798018790
EXPO_PUBLIC_POSTHOG_API_KEY=your_peri_project_token
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_ANALYTICS_API_URL=https://your-peri-api.example.com
# Exact App Store product IDs, comma-separated; must match ANALYTICS_PRODUCT_IDS on server.
EXPO_PUBLIC_ANALYTICS_PRODUCT_IDS=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_peri_public_sdk_key
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN belongs in EAS build secrets, never EXPO_PUBLIC variables.
