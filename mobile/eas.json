{
  "cli": { "version": ">= 23.0.0", "appVersionSource": "remote" },
  "build": {
    "store-capture": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "store-capture",
      "autoIncrement": false,
      "ios": { "simulator": true, "buildConfiguration": "Release" }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "uploadSourceMaps": true
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "uploadSourceMaps": true
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6798018790" }
    }
  }
}
