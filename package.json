{
  "name": "menlopass",
  "version": "1.0.0",
  "private": true,
  "description": "Private, offline-capable menopause tracker and reference PWA",
  "scripts": {
    "build": "python build.py",
    "test": "npm run build && node test.js",
    "test:e2e": "node test.js",
    "test:install": "playwright install chromium",
    "screenshots:store": "node mobile/store-assets/generate-screenshots.js",
    "screenshots:store:compose": "node mobile/store-assets/generate-screenshots.js --compose-only",
    "demo:product": "node mobile/store-assets/generate-product-demo.js",
    "mobile:sync": "npm --prefix mobile run sync:web",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:export:web": "npm --prefix mobile run export:web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "1.62.0"
  }
}
